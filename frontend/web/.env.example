# AeroPulse web — local configuration.
#
# Copy to `.env.local` (gitignored) and fill in a token.

# Where the AeroPulse API is served. Compose sets this for the container;
# this value is for `npm run dev` on the host.
VITE_API_BASE=http://127.0.0.1:8000

# Bearer token for /api/v1. Every route except /health requires one.
# Mint a VIEWER token from the repo root:
#   uv run python -c "from aeropulse_auth import encode_token, Role; print(encode_token('ui', [Role.VIEWER]))"
#
# Development only (HS256, ADR-0003). A token in a browser bundle is readable
# by anyone who loads the page, so this must never carry a production secret.
VITE_API_TOKEN=

# Mode on first load: `demo` (default) or `live`. Live is only entered when
# the API also answers /health.
VITE_DEFAULT_DATA_MODE=demo
