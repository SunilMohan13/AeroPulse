AEROPULSE_JWT_SECRET=dev-only-change-me-use-32-bytes-min
AEROPULSE_CONNECTOR_MODE=replay
# Host ports when talking to the Compose stack from the machine (not from inside a container).
AEROPULSE_DATABASE_URL=postgresql://aeropulse:aeropulse@127.0.0.1:5433/aeropulse
AEROPULSE_REDIS_URL=redis://127.0.0.1:6380/0
AEROPULSE_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
AEROPULSE_LOG_LEVEL=INFO

# --- Live sources (both free to obtain; absence reports NOT_CONFIGURED
# rather than silently replaying a fixture) ---
# https://explore.openaq.org  -> account -> API key
AEROPULSE_OPENAQ_API_KEY=8189ad6b5bb3f27e677045addc1478f555b8f7c63a9490614cc4a18cf39444f1
# https://firms.modaps.eosdis.nasa.gov/api/map_key
AEROPULSE_FIRMS_MAP_KEY=5ad11797490f16b0f27de912db4c3009

# --- Copilot ---
# Server-side only. Never expose this to the browser bundle: the frontend
# already ships a JWT there, and a second secret must not follow it.
# Without a key the copilot degrades to deterministic retrieval and says so.
AEROPULSE_GEMINI_API_KEY=
AEROPULSE_GEMINI_MODEL=gemini-3.6-flash
